# Copy this file to `.env` and replace the placeholders with real values.
# `.env` is git-ignored; never commit real credentials here.

# PostgreSQL connection string.
# Used by: prisma/schema.prisma (env("DATABASE_URL")), prisma/seed.ts,
# and scripts/run-proofs.ts. Required for `prisma migrate dev`,
# `prisma generate`, `npm run prisma:seed` and `npm run proof:run`.
DATABASE_URL="postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public"
